# -------------------------------------------------------------
# SourceLock - Environment Configuration
# -------------------------------------------------------------

# AI Provider Settings
# Choose one of the following and paste your key below:
# - GROQ_API_KEY (Recommended: very fast, free)
# - GEMINI_API_KEY (Google Gemini free tier)
# - OPENROUTER_API_KEY (Access to multiple models)

GROQ_API_KEY=your_key_here
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Set your active provider (groq | gemini | openrouter)
AI_PROVIDER=groq

# Server Ports (Default: 3001 for backend, 5173 for frontend)
PORT=3001
